# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================================

# PostgreSQL (Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# ===========================================

# JWT Secret (debe coincidir con el de docker-compose.yml)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Configuración de autenticación
AUTH_SITE_URL=http://localhost:3000
AUTH_URI_ALLOW_LIST=*

# ===========================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ===========================================

# Para desarrollo local, puedes usar un servicio como MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Flamenco Sync Studio

# ===========================================
# CONFIGURACIÓN DE STORAGE
# ===========================================

# Storage local
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

# ===========================================
# CONFIGURACIÓN DE INTEGRACIONES
# ===========================================

# WooCommerce (si usas integración)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Holded (si usas integración)
HOLDED_API_URL=
HOLDED_API_KEY=

# ===========================================
# CONFIGURACIÓN DE DESARROLLO
# ===========================================

# Modo de desarrollo
NODE_ENV=development
VITE_NODE_ENV=development

# URLs de desarrollo
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN (EJEMPLO)
# ===========================================

# Para producción, cambia estas URLs:
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica-real
# DATABASE_URL=postgres://usuario:password@host:puerto/database
